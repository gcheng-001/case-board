+            if not isinstance(instance, dict):
+                continue
+            roles = instance.get("roles")
+            if self._option_id_value(instance) and isinstance(roles, list) and any(self._option_id_value(role) for role in roles if isinstance(role, dict)):
+                return True
+        return False
